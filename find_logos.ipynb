   "source": [
    "import os\n",
    "results = []\n",
    "for root, dirs, files in os.walk('.'):\n",
    "    for f in files:\n",
    "        if f.endswith('.png') or f.endswith('.jpg'):\n",
    "            results.append(os.path.join(root, f))\n",
    "for r in sorted(results):\n",
    "    print(r)"
   ]
